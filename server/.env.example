SUPABASE_URL=
SUPABASE_ANON_KEY=

# The Python scheduler service (ml/csp/api.py) and the key both sides share.
SCHEDULER_URL=http://localhost:8000
SERVICE_API_KEY=

# Optional: the preference model on its Hugging Face Space (ml/serve). Without MODEL_URL, preferences come
# from the fixed rules only. MODEL_HF_TOKEN is a Hugging Face read token (the Space is private);
# MODEL_API_KEY defaults to SERVICE_API_KEY and must match the Space's SERVICE_API_KEY secret.
MODEL_URL=
MODEL_HF_TOKEN=
MODEL_API_KEY=

# Encrypts personal data before it's saved to Supabase (crypto.js). 32 random bytes, base64. Required: the
# server won't start without it. Everyone running the server against the same database needs the same key,
# and losing it means the encrypted data can't be read again. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Only for scripts/encrypt-existing.js (it has to read every user's rows). Remove it again afterwards.
SUPABASE_SERVICE_ROLE_KEY=
