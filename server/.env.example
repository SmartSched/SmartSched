SUPABASE_URL=
SUPABASE_ANON_KEY=

# The Python scheduler service (ml/csp/api.py) and the key both sides share.
SCHEDULER_URL=http://localhost:8000
SERVICE_API_KEY=

# Optional: the preference model on its Hugging Face Space (ml/serve). Without MODEL_URL, preferences come
# from the fixed rules only. MODEL_HF_TOKEN is a Hugging Face read token (the Space is private);
# MODEL_API_KEY defaults to SERVICE_API_KEY and must match the Space's SERVICE_API_KEY secret.
MODEL_URL=
MODEL_HF_TOKEN=
MODEL_API_KEY=
